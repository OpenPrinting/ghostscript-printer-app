[Unit]
Description=Ghostscript Printer Application
Documentation=https://github.com/OpenPrinting/ghostscript-printer-app
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/openprinting/ghostscript-printer-app:latest
ContainerName=ghostscript-printer-app
Network=host
AddDevice=/dev/bus/usb:/dev/bus/usb:rwm
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket:ro
Volume=ghostscript-printer-app-data:/var/lib/ghostscript-printer-app
Volume=ghostscript-printer-app-spool:/var/spool/ghostscript-printer-app
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s

[Install]
WantedBy=default.target
